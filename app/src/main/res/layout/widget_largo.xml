<?xml version="1.0" encoding="utf-8"?>
<!-- Riquadro orizzontale: scena a sinistra (disegnata in SceneRenderer), testo a destra -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radice"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sfondo_widget"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/scena"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="2dp"
            android:paddingEnd="12dp">

            <TextView
                style="@style/TestoWidget.Luogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/luogo" />

            <TextClock
                android:id="@+id/ora"
                style="@style/TestoWidget.Ora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:textSize="30sp" />

            <TextClock
                android:id="@+id/data"
                style="@style/TestoWidget.Data"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:format12Hour="EEEE d MMMM"
                android:format24Hour="EEEE d MMMM" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/temp"
                    style="@style/TestoWidget.Temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--°"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/cielo"
                    style="@style/TestoWidget.Cielo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:maxLines="2"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/dettagli"
                style="@style/TestoWidget.Dettagli"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
