<?xml version="1.0" encoding="utf-8"?>
<!-- Riquadro quadrato o verticale: scena sopra, testo sotto -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radice"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sfondo_widget"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/scena"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/ora"
                style="@style/TestoWidget.Ora"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/temp"
                style="@style/TestoWidget.Temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--°"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/cielo"
            style="@style/TestoWidget.Cielo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/dettagli"
            style="@style/TestoWidget.Dettagli"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:textSize="9sp" />
    </LinearLayout>
</FrameLayout>
